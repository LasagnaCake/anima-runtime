html `
<<main title="With expression">>
<<section>>
	<<title>><<code-inline>><<kw text="with"/>><</code-inline>> expression<</title>>
	<<p>>
        In case the compiler is having difficulties parsing your type declaration,
        simply use the <<code-inline>><<kw text="with"/>> <<expr text="type"/>><</code-inline>> expression.
	<</p>>
<</section>>
<</main>>
`
